# =============================================================================
# Environment configuration template.
# Copy this file to `.env` and fill in real values. NEVER commit a real `.env`.
# =============================================================================

# MongoDB connection string (required in production).
# Example (MongoDB Atlas):
# MONGODB_URI=mongodb+srv://<user>:<password>@<cluster-host>/<database>?retryWrites=true&w=majority
MONGODB_URI=

# Secret used to sign admin JWT session tokens (required in production).
# Generate a strong random value, e.g. `openssl rand -hex 32`.
JWT_SECRET=

# Transactional email provider (Resend HTTPS API) — required for contact form delivery.
EMAIL_PROVIDER_API_KEY=
CONTACT_RECEIVER_EMAIL=you@example.com
EMAIL_FROM=onboarding@resend.dev
# Initial administrator account seeded on first boot. Change these before deploying.
# NOTE: these only create an admin when none exists — changing the password later does
# NOT update an existing admin. To deliberately reset the admin password, set
# ADMIN_SYNC_PASSWORD=true for one deploy (then unset it).
ADMIN_INITIAL_EMAIL=admin@example.com
# IMPORTANT: if the password contains '#', wrap the value in double quotes (e.g. "pa#ss")
# or everything after '#' will be treated as an inline comment by dotenv.
ADMIN_INITIAL_PASSWORD=ChangeThisStrongPassword123!
ADMIN_SYNC_PASSWORD=false

# Comma-separated list of browser origins allowed to call the API (production CORS).
# Must be the EXACT origin the browser sends in the Origin header: scheme + host +
# optional port, and NO trailing slash and NO path. A trailing slash or stray space
# is tolerated by this server (it is normalized), but keeping it clean is best practice.
# Example (single static frontend on Render):
#   CORS_ORIGINS=https://principal-portfolio-forntend.onrender.com
# Example (multiple custom domains):
#   CORS_ORIGINS=https://your-domain.com,https://www.your-domain.com
# Leaving this empty in production blocks ALL cross-origin browser requests, which
# surfaces in the browser as "No 'Access-Control-Allow-Origin' header is present".
CORS_ORIGINS=

# Server port (hosting platforms such as Render inject this automatically).
PORT=3000
# Node environment: development | production
NODE_ENV=development

# Uploaded-image storage directory.
# Default: <repo-root>/backend/data/uploads (existing behavior, ephemeral on Render).
# Production: REQUIRED for images to persist. Set this to a path inside a Render
# Persistent Disk mount so uploads survive redeploys/restarts, e.g.
# UPLOADS_DIR=/var/data/uploads (with the disk mounted at /var/data).
# Leaving it unset in production writes images to the ephemeral container
# filesystem — uploads appear instantly but break after the next restart. The
# server logs a [Uploads] WARNING at boot in that case.
# See render.yaml for the full Blueprint (disk + env var wired together).
UPLOADS_DIR=

