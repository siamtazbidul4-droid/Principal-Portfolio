# =============================================================================
# Environment configuration template.
# Copy this file to `.env` and fill in real values. NEVER commit a real `.env`.
# =============================================================================

# MongoDB connection string (required in production).
# Example (MongoDB Atlas):
# MONGODB_URI=mongodb+srv://<user>:<password>@<cluster-host>/<database>?retryWrites=true&w=majority
MONGODB_URI=

# Secret used to sign admin JWT session tokens (required in production).
# Generate a strong random value, e.g. `openssl rand -hex 32`.
JWT_SECRET=

# Transactional email provider (Resend HTTPS API) — required for contact form delivery.
EMAIL_PROVIDER_API_KEY=
CONTACT_RECEIVER_EMAIL=you@example.com
EMAIL_FROM=onboarding@resend.dev
# Initial administrator account seeded on first boot. Change these before deploying.
# NOTE: these only create an admin when none exists — changing the password later does
# NOT update an existing admin. To deliberately reset the admin password, set
# ADMIN_SYNC_PASSWORD=true for one deploy (then unset it).
ADMIN_INITIAL_EMAIL=admin@example.com
# IMPORTANT: if the password contains '#', wrap the value in double quotes (e.g. "pa#ss")
# or everything after '#' will be treated as an inline comment by dotenv.
ADMIN_INITIAL_PASSWORD=ChangeThisStrongPassword123!
ADMIN_SYNC_PASSWORD=false

# Comma-separated list of browser origins allowed to call the API (production CORS).
# Example: https://your-domain.com,https://www.your-domain.com
CORS_ORIGINS=

# Server port (hosting platforms such as Render inject this automatically).
PORT=3000
# Node environment: development | production
NODE_ENV=development

